pipeline {
    agent any

    environment {
        // Pointing directly to your Docker installation
        PATH = "C:\\Users\\user\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        SERVICE_NAME = 'user-service'
        HOST_PORT = '8081'
        CONTAINER_PORT = '8080'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Pulling code from repository...'
                checkout scm
            }
        }

        stage('Build with Maven') {
            steps {
                echo 'Building multi-module project and user-service...'
                dir('microservices') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Docker image for user-service...'
                dir('microservices/user-service') {
                    bat "docker build -t ${SERVICE_NAME}:latest ."
                }
            }
        }

        stage('Deploy Container') {
            steps {
                echo 'Stopping old container and starting the new one...'
                bat "docker stop ${SERVICE_NAME} || exit 0"
                bat "docker rm ${SERVICE_NAME} || exit 0"
                // Run on host port 8081 so it doesn't clash with Jenkins on 8080
                bat "docker run -d -p ${HOST_PORT}:${CONTAINER_PORT} --name ${SERVICE_NAME} ${SERVICE_NAME}:latest"
            }
        }
    }

    post {
        success {
            echo '========================================='
            echo ' CI/CD Pipeline Completed Successfully!  '
            echo '========================================='
        }
        failure {
            echo 'Build failed. Check the logs above.'
        }
    }
}