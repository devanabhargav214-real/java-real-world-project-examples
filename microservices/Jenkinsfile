pipeline {
    agent any

    environment {
        // Docker path on your system
        PATH = "C:\\Users\\user\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        SERVICE_NAME = 'user-service'
        IMAGE_TAG = "user-service:${env.BUILD_NUMBER}"
    }

    stages {
        // ==========================================
        // 1. BUILD & PACKAGE (CI)
        // ==========================================
        stage('Build with Maven') {
            steps {
                echo 'Compiling and packaging all microservices...'
                dir('microservices') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Docker Build Image') {
            steps {
                echo "Building Docker image ${IMAGE_TAG}..."
                dir('microservices/user-service') {
                    bat "docker build -t ${IMAGE_TAG} -t ${SERVICE_NAME}:latest ."
                }
            }
        }

        // ==========================================
        // 2. DEV ENVIRONMENT (AUTO)
        // ==========================================
        stage('Deploy to DEV (Port 8081)') {
            environment {
                DEV_APP = 'user-service-dev'
                DEV_PORT = '8081'
            }
            steps {
                echo 'Starting DEV container...'
                bat "docker stop ${DEV_APP} || exit 0"
                bat "docker rm ${DEV_APP} || exit 0"
                // Passes host.docker.internal so Spring Boot finds MySQL on your PC
                bat """
                    docker run -d -p ${DEV_PORT}:8080 ^
                    -e SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/bank_db?createDatabaseIfNotExist=true^&useSSL=false ^
                    -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://host.docker.internal:8761/eureka/ ^
                    --name ${DEV_APP} ${IMAGE_TAG}
                """
            }
        }

        // ==========================================
        // 3. STAGE ENVIRONMENT (AUTO)
        // ==========================================
        stage('Deploy to STAGE (Port 8082)') {
            environment {
                STAGE_APP = 'user-service-stage'
                STAGE_PORT = '8082'
            }
            steps {
                echo 'Starting STAGE container...'
                bat "docker stop ${STAGE_APP} || exit 0"
                bat "docker rm ${STAGE_APP} || exit 0"
                bat """
                    docker run -d -p ${STAGE_PORT}:8080 ^
                    -e SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/bank_db?createDatabaseIfNotExist=true^&useSSL=false ^
                    -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://host.docker.internal:8761/eureka/ ^
                    --name ${STAGE_APP} ${IMAGE_TAG}
                """
            }
        }

        // ==========================================
        // 4. MANUAL APPROVAL GATE
        // ==========================================
        stage('Approve for Production') {
            steps {
                input message: 'Do you want to deploy this build to PRODUCTION?', ok: 'Deploy to Production'
            }
        }

        // ==========================================
        // 5. PROD ENVIRONMENT (LIVE)
        // ==========================================
        stage('Deploy to PROD (Port 8083)') {
            environment {
                PROD_APP = 'user-service-prod'
                PROD_PORT = '8083'
            }
            steps {
                echo 'Starting PRODUCTION container...'
                bat "docker stop ${PROD_APP} || exit 0"
                bat "docker rm ${PROD_APP} || exit 0"
                bat """
                    docker run -d -p ${PROD_PORT}:8080 ^
                    -e SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/bank_db?createDatabaseIfNotExist=true^&useSSL=false ^
                    -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://host.docker.internal:8761/eureka/ ^
                    --name ${PROD_APP} ${IMAGE_TAG}
                """
            }
        }
    }

    post {
        success {
            echo 'All environments deployed successfully!'
        }
    }
}