pipeline {
    agent any

    environment {
        PATH = "C:\\Users\\user\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        SERVICE_NAME = 'user-service'
        HOST_PORT = '8081'
        CONTAINER_PORT = '8080'
    }

    stages {
        // ================= CI: RUNS FOR EVERY PUSH =================
        stage('Checkout Code') {
            steps {
                echo "Pulling latest commit made by team..."
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                echo 'Compiling microservices and executing unit tests...'
                dir('microservices') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        // ================= CD: RUNS ON MAIN BRANCH =================
        stage('Build Docker Image') {
            when {
                branch 'main'
            }
            steps {
                echo 'Building updated Docker image...'
                dir('microservices/user-service') {
                    bat "docker build -t ${SERVICE_NAME}:latest ."
                }
            }
        }

        stage('Deploy Application') {
            when {
                branch 'main'
            }
            steps {
                echo 'Stopping existing version and deploying new version...'
                bat "docker stop ${SERVICE_NAME} || exit 0"
                bat "docker rm ${SERVICE_NAME} || exit 0"
                bat "docker run -d -p ${HOST_PORT}:${CONTAINER_PORT} --name ${SERVICE_NAME} ${SERVICE_NAME}:latest"
            }
        }
    }

    post {
        success {
            echo '===================================================='
            echo " Build #${env.BUILD_NUMBER} Finished Successfully! "
            echo '===================================================='
        }
        failure {
            echo "Pipeline failed on build #${env.BUILD_NUMBER}. Check console output."
        }
    }
}