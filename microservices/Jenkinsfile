pipeline {
    agent any

    environment {
        PATH = "C:\\Users\\user\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        NETWORK_NAME = 'banking-network'
    }

    stages {
        stage('Build with Maven') {
            steps {
                echo 'Building all microservices...'
                dir('microservices') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Prepare Docker Network') {
            steps {
                bat "docker network create ${NETWORK_NAME} || exit 0"
            }
        }

        stage('Deploy Eureka Server') {
            steps {
                echo 'Starting Eureka Server...'
                dir('microservices/eureka-server') {
                    bat 'docker build -t eureka-server:latest .'
                }
                bat 'docker stop eureka-server || exit 0'
                bat 'docker rm eureka-server || exit 0'
                bat "docker run -d --name eureka-server --network ${NETWORK_NAME} -p 8761:8761 eureka-server:latest"
            }
        }

        stage('Deploy User Service') {
            steps {
                echo 'Starting User Service...'
                dir('microservices/user-service') {
                    bat 'docker build -t user-service:latest .'
                }
                bat 'docker stop user-service || exit 0'
                bat 'docker rm user-service || exit 0'
                bat "docker run -d --name user-service --network ${NETWORK_NAME} -p 8081:8081 user-service:latest"
            }
        }
    }

    post {
        success {
            echo '====================================================='
            echo ' Eureka Dashboard: http://localhost:8761             '
            echo ' User Service:     http://localhost:8081             '
            echo '====================================================='
        }
    }
}