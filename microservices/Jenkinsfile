pipeline {
    agent any

    environment {
        DOCKER_NETWORK = 'banking-network'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Checking out source code from Git...'
                checkout scm
            }
        }

        stage('Build with Maven') {
            steps {
                echo 'Packaging reactor modules (Config Server, Eureka Server, User Service, Category Service)...'
                dir('microservices') {
                    // Compiles all modules defined in microservices/pom.xml
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Prepare Docker Network') {
            steps {
                echo 'Ensuring Docker network exists...'
                // Creates banking-network if it does not already exist
                bat 'docker network create %DOCKER_NETWORK% || exit 0'
            }
        }

        stage('Deploy Eureka Server') {
            steps {
                echo 'Building and starting Eureka Server container...'
                dir('microservices/eureka-server') {
                    bat 'docker build -t eureka-server:latest .'
                    bat 'docker stop eureka-server || exit 0'
                    bat 'docker rm eureka-server || exit 0'
                    bat 'docker run -d --name eureka-server --net %DOCKER_NETWORK% -p 8761:8761 eureka-server:latest'
                }
            }
        }

        stage('Deploy User Service') {
            steps {
                echo 'Building and starting User Service container...'
                dir('microservices/user-service') {
                    bat 'docker build -t user-service:latest .'
                    bat 'docker stop user-service || exit 0'
                    bat 'docker rm user-service || exit 0'
                    bat 'docker run -d --name user-service --net %DOCKER_NETWORK% -p 8081:8081 user-service:latest'
                }
            }
        }

        stage('Deploy Category Service') {
            steps {
                echo 'Building and starting Category Service container...'
                dir('microservices/category-service') {
                    bat 'docker build -t category-service:latest .'
                    bat 'docker stop category-service || exit 0'
                    bat 'docker rm category-service || exit 0'
                    bat 'docker run -d --name category-service --net %DOCKER_NETWORK% -p 8082:8082 category-service:latest'
                }
            }
        }
    }

    post {
        always {
            echo 'Jenkins pipeline execution completed.'
        }
        success {
            echo 'SUCCESS: All microservices (Eureka, User Service, Category Service) built and deployed!'
        }
        failure {
            echo 'FAILURE: Pipeline encountered errors. Please check stage logs above.'
        }
    }
}