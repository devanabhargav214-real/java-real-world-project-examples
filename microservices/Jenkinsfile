pipeline {
    agent any

    environment {
        // Docker CLI Path
        PATH = "C:\\Users\\user\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        SERVICE_NAME = 'user-service'
        HOST_PORT = '8081'
        CONTAINER_PORT = '8080'
    }

    stages {
        // 1. Maven Build & Package
        stage('Build with Maven') {
            steps {
                echo 'Building multi-module project and user-service...'
                dir('microservices') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        // 2. Docker Image Build
        stage('Docker Build') {
            steps {
                echo 'Building Docker image for user-service...'
                dir('microservices/user-service') {
                    bat "docker build -t ${SERVICE_NAME}:latest ."
                }
            }
        }

        // 3. Automatic Deployment (No Prompts/Pauses)
        stage('Deploy Container') {
            steps {
                echo 'Stopping old container and deploying new container...'
                bat "docker stop ${SERVICE_NAME} || exit 0"
                bat "docker rm ${SERVICE_NAME} || exit 0"
                bat """
                    docker run -d -p ${HOST_PORT}:${CONTAINER_PORT} ^
                    -e SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/bank_db?createDatabaseIfNotExist=true^&useSSL=false ^
                    -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://host.docker.internal:8761/eureka/ ^
                    --name ${SERVICE_NAME} ${SERVICE_NAME}:latest
                """
            }
        }
    }

    post {
        success {
            echo '====================================================='
            echo ' Application deployed automatically & successfully!   '
            echo ' Live at: http://localhost:8081                       '
            echo '====================================================='
        }
        failure {
            echo 'Build failed. Check the console logs.'
        }
    }
}