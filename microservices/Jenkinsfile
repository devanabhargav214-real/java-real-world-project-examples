pipeline {
    agent any

    environment {
        PATH = "C:\\Users\\user\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        NETWORK_NAME = 'banking-network'
    }

    stages {
        // ----------------------------------------------------
        // Stage 1: Build All Microservices (Maven)
        // ----------------------------------------------------
        stage('Build Microservices') {
            steps {
                echo 'Compiling and packaging Eureka Server and User Service...'
                dir('microservices') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        // ----------------------------------------------------
        // Stage 2: Create Docker Network
        // ----------------------------------------------------
        stage('Prepare Docker Network') {
            steps {
                echo 'Setting up Docker network for microservices communication...'
                bat "docker network create ${NETWORK_NAME} || exit 0"
            }
        }

        // ----------------------------------------------------
        // Stage 3: Build & Deploy Eureka Server
        // ----------------------------------------------------
        stage('Deploy Eureka Server') {
            steps {
                echo 'Building and running Eureka Server container...'
                dir('microservices/eureka-server') {
                    bat 'docker build -t eureka-server:latest .'
                }
                bat 'docker stop eureka-server || exit 0'
                bat 'docker rm eureka-server || exit 0'
                bat """
                    docker run -d ^
                    --name eureka-server ^
                    --network ${NETWORK_NAME} ^
                    -p 8761:8761 ^
                    eureka-server:latest
                """
            }
        }

        // ----------------------------------------------------
        // Stage 4: Build & Deploy User Service
        // ----------------------------------------------------
        stage('Deploy User Service') {
            steps {
                echo 'Building and running User Service container...'
                dir('microservices/user-service') {
                    bat 'docker build -t user-service:latest .'
                }
                bat 'docker stop user-service || exit 0'
                bat 'docker rm user-service || exit 0'
                bat """
                    docker run -d ^
                    --name user-service ^
                    --network ${NETWORK_NAME} ^
                    -p 8081:8080 ^
                    -e SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/bank_db?createDatabaseIfNotExist=true^&useSSL=false ^
                    -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/ ^
                    user-service:latest
                """
            }
        }
    }

    post {
        success {
            echo '====================================================='
            echo ' Both Eureka and User-Service are live!              '
            echo ' Eureka Dashboard: http://localhost:8761             '
            echo ' User Service:     http://localhost:8081             '
            echo '====================================================='
        }
        failure {
            echo 'Pipeline failed. Check previous stage error logs.'
        }
    }
}