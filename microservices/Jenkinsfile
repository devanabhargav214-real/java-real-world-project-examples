pipeline {
    agent any

    environment {
        PATH = "C:\\Users\\user\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
        NETWORK_NAME = 'banking-network'
    }

    stages {
        // ----------------------------------------------------
        // Stage 1: Build All Microservices
        // ----------------------------------------------------
        stage('Build with Maven') {
            steps {
                echo 'Compiling and packaging all microservices...'
                dir('microservices') {
                    bat 'mvn clean package -DskipTests'
                }
            }
        }

        // ----------------------------------------------------
        // Stage 2: Create Docker Network
        // ----------------------------------------------------
        stage('Prepare Network') {
            steps {
                echo 'Creating shared Docker network...'
                bat "docker network create ${NETWORK_NAME} || exit 0"
            }
        }

        // ----------------------------------------------------
        // Stage 3: Deploy Eureka Server
        // ----------------------------------------------------
        stage('Deploy Eureka Server') {
            steps {
                echo 'Building and starting Eureka Server...'
                dir('microservices/eureka-server') {
                    bat 'docker build -t eureka-server:latest .'
                }
                bat 'docker stop eureka-server || exit 0'
                bat 'docker rm eureka-server || exit 0'
                bat """
                    docker run -d ^
                    --name eureka-server ^
                    --network ${NETWORK_NAME} ^
                    -p 8761:8761 ^
                    eureka-server:latest
                """
            }
        }

        // ----------------------------------------------------
        // Stage 4: Deploy User Service
        // ----------------------------------------------------
        stage('Deploy User Service') {
            steps {
                echo 'Building and starting User Service...'
                dir('microservices/user-service') {
                    bat 'docker build -t user-service:latest .'
                }
                bat 'docker stop user-service || exit 0'
                bat 'docker rm user-service || exit 0'
                bat """
                    docker run -d ^
                    --name user-service ^
                    --network ${NETWORK_NAME} ^
                    -p 8081:8081 ^
                    -e SPRING_DATASOURCE_URL=jdbc:mysql://host.docker.internal:3306/user_service_db?createDatabaseIfNotExist=true^&useSSL=false ^
                    -e SPRING_DATASOURCE_USERNAME=root ^
                    -e SPRING_DATASOURCE_PASSWORD=root ^
                    -e EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://eureka-server:8761/eureka/ ^
                    user-service:latest
                """
            }
        }
    }

    post {
        success {
            echo '====================================================='
            echo ' Eureka Server: http://localhost:8761                '
            echo ' User Service:  http://localhost:8081                '
            echo '====================================================='
        }
    }
}